[Desktop Entry]
Type=Application
Name=WoA RK3576 Imager
Comment=Install Windows on RK3576 boards over USB and write their UEFI firmware
Exec=woa-rk3576-imager %U
Icon=io.github.gahingwoo.woa_rk3576_imager
Categories=Utility;
Keywords=SD card;image;flash;maskrom;eMMC;
Terminal=false
# What Electron sets from package.json desktopName: the Wayland app_id and
# the X11 WM_CLASS are both io.github.gahingwoo.woa_rk3576_imager.
StartupWMClass=io.github.gahingwoo.woa_rk3576_imager
